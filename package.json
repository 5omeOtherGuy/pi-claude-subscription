{
  "name": "pi-claude-subscription",
  "version": "0.1.0",
  "description": "Pi package for using Claude Pro and Max subscriptions in the Pi coding agent through Claude Code OAuth.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "claude",
    "anthropic",
    "claude-code",
    "oauth",
    "pi-extension",
    "pi-coding-agent",
    "claude-subscription",
    "claude-pro",
    "claude-max"
  ],
  "homepage": "https://github.com/5omeOtherGuy/pi-claude-subscription#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5omeOtherGuy/pi-claude-subscription.git"
  },
  "bugs": {
    "url": "https://github.com/5omeOtherGuy/pi-claude-subscription/issues"
  },
  "files": [
    "extensions/",
    "src/",
    "docs/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-claude-subscription"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.6 <2",
    "@earendil-works/pi-coding-agent": ">=0.80.6 <2"
  },
  "scripts": {
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "npm run -s secret-scan && node --test --test-reporter=dot --import tsx \"tests/**/*.test.ts\" && npm run -s typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "~22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "8.12.2"
  }
}
